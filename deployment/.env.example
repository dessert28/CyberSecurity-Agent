# 网络安全智能体环境配置
# XH-202609 比赛提交版本

# 运行时数据根目录（默认：项目根目录下的 var/workbench）
# CYBER_AGENT_RUNTIME_ROOT=D:\path\to\runtime

# 启动令牌（留空则自动生成）
# CYBER_AGENT_LAUNCH_TOKEN=

# Docker 可执行文件路径（用于容器隔离场景）
# CYBER_AGENT_DOCKER_PATH=C:\Program Files\Docker\Docker\resources\bin\docker.exe

# 服务器配置
CYBER_AGENT_HOST=127.0.0.1
CYBER_AGENT_PORT=8765

# 模型配置（示例）
# KIMI_API_KEY=your_kimi_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 日志级别
# CYBER_AGENT_LOG_LEVEL=INFO
